<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@android:color/white"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/searchPartyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Party"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/itemNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Looking for: Item Name"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:alpha="0.9"/>
        </LinearLayout>

        <TextView
            android:id="@+id/participantCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/circle_badge"
            android:gravity="center"
            android:minWidth="28dp"
            android:minHeight="28dp"/>
    </LinearLayout>

    <!-- Participants Section -->
    <LinearLayout
        android:id="@+id/participantsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_white"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Participants"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/participantsList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Progress Section -->
    <LinearLayout
        android:id="@+id/progressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_white"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/participantsSection">

        <ProgressBar
            android:id="@+id/searchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/found_text"/>

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/10 zones checked"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- Zones List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/zonesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/progressSection"
        app:layout_constraintBottom_toTopOf="@id/chatSection"/>

    <!-- Chat Section (collapsible) -->
    <LinearLayout
        android:id="@+id/chatSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_white"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActions">

        <!-- Chat Header (always visible, tap to toggle) -->
        <LinearLayout
            android:id="@+id/chatHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/primary"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Team Chat"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/chatUnreadBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/circle_badge"
                android:backgroundTint="@color/lost_text"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/chatExpandIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/arrow_up_float"
                app:tint="@color/text_secondary"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Chat Content (expandable) -->
        <LinearLayout
            android:id="@+id/chatContent"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Messages List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:clipToPadding="false"/>

            <!-- Message Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@color/background_light">

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="Type a message..."
                    android:textSize="14sp"
                    android:background="@drawable/rounded_input"
                    android:paddingHorizontal="12dp"
                    android:maxLines="1"
                    android:imeOptions="actionSend"
                    android:inputType="text"/>

                <ImageView
                    android:id="@+id/btnSendChat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@android:color/white"
                    android:background="@drawable/circle_badge"
                    android:backgroundTint="@color/primary"
                    android:padding="10dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_white"
        android:padding="16dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnLeaveParty"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Leave"
            android:textColor="@color/lost_text"
            android:backgroundTint="@color/background_light"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnEndParty"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="End Search"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primary"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnInvite"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Invite"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primary"/>
    </LinearLayout>

    <!-- Found Overlay (shows when item is found) -->
    <LinearLayout
        android:id="@+id/foundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC4CAF50"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@android:color/white"/>

        <TextView
            android:id="@+id/foundTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Found!"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/foundDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Found by User at Location"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnDismissFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="#4CAF50"
            android:backgroundTint="@android:color/white"
            android:layout_marginTop="24dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
